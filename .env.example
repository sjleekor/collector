# collector — 비밀만 둔다. 비-비밀 설정은 코드 기본값과 .envrc에 있다.
# 복사해서 쓴다:  cp .env.example .env
# 값을 여기에 적지 않는다. 커밋되는 파일이다.

# --- 공통 -------------------------------------------------------------------
DB_DSN=
FRED_API_KEY=            # https://fred.stlouisfed.org/docs/api/api_key.html

# --- 한국 -------------------------------------------------------------------
OPENDART_API_KEY=        # https://opendart.fss.or.kr
AUTH_KEYS=               # KRX Open API. 쉼표로 여러 개
KIS_APP_KEY=             # 한국투자증권 오픈API
KIS_APP_SECRET=
ECOS_API_KEY=            # 한국은행 ECOS
KRX_ID=                  # KRX MDC 로그인 폴백
KRX_PW=
DATAGO_KEY=              # 공공데이터포털. 현재 어느 어댑터도 읽지 않는다
REMOTE_DB_INFO_PATH=     # S2에서 절대경로 기본값을 뺐다

# --- 미국 -------------------------------------------------------------------
# 비밀이 아니다. 연락처가 들어간 UA — 없으면 www.sec.gov가 403이다.
# 공백과 괄호가 있으니 따옴표로 감싼다.
SEC_USER_AGENT="<name>/<ver> (<contact email>)"
ALPHAVANTAGE_API_KEY=    # C1에서 탈락(일 25건 한도). 채울 필요 없다
